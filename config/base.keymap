#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/key-labels/34.h" // Provides LT0, RB0, etc. key positions

// Layer indices as numeric constants
#define DEFAULT 0
#define STURDY 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define UNICODE 5
#define MOUSE 6
#define GAME 7
#define GMOD 8

#define QUICK_TAP_MS 175

// If your code previously redefined LT0, RB0, etc., remove those lines. 
// We'll rely solely on zmk-helpers/key-labels/34.h for key positions.

// The sticky-layer behavior that will accept a layer argument
&sl {
    ignore-modifiers;
    #binding-cells = <1>; // Allows passing a layer argument like &sl RAISE
};

// Define the num_word behavior to accept one argument
behaviors {
    num_word: num_word {
        compatible = "zmk,behavior-num-word";
        label = "NUM_WORD";
        #binding-cells = <1>; // Now &num_word RAISE is valid
    };
};

// We define a hold-tap behavior named smart_num that will be referenced as &smart_num RAISE 0
// This requires #binding-cells = <2> since we're passing two arguments (layer and a number).
ZMK_HOLD_TAP(smart_num) {
    #binding-cells = <2>;
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo RAISE>, <&num_dance>;
};

// Tap dance that references num_word and sl with an argument (RAISE).
// num_dance itself does not need #binding-cells because we are not passing arguments to &num_dance.
// The arguments apply to the behaviors in the bindings array, which already have #binding-cells = <1>.
ZMK_TAP_DANCE(num_dance) {
    tapping-term-ms = <200>;
    bindings = <&num_word RAISE>, <&sl RAISE>;
};

// A mod-morph behavior for smart shift
ZMK_MOD_MORPH(smart_shft) {
    bindings = <&sk LSHFT>, <&caps_word>;
    mods = <(MOD_LSFT)>;
};

// Delete ignore-modifiers from caps_word node to restore normal caps_word behavior if needed
&caps_word {
    /delete-property/ ignore-modifiers;
};

// Example hold-tap for thumb keys (tap: space | hold: ctrl)
ZMK_HOLD_TAP(thumb_key) {
    flavor="tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    bindings = <&kp>, <&kp>;
};

#define CTL_SPC &thumb_key LCTL SPACE

// Example definitions for masked_home and masked_end (mod-morph behaviors)
ZMK_MOD_MORPH(masked_home) {
    bindings = <&kp HOME>, <&kp HOME>;
    mods = <(MOD_LCTL)>;
};

ZMK_MOD_MORPH(masked_end) {
    bindings = <&kp END>, <&kp END>;
    mods = <(MOD_LCTL)>;
};

// Example hold-tap definitions for navigation keys
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
};

ZMK_HOLD_TAP(mt_home) {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
    bindings = <&masked_home>, <&kp>;
};

ZMK_HOLD_TAP(mt_end) {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
    bindings = <&masked_end>, <&kp>;
};

// Tri-state behavior for smart_mouse
ZMK_TRI_STATE(smart_mouse) {
    bindings = <&tog MOUSE>, <&none>, <&tog MOUSE>;
    // Provide numeric key positions that are valid for your keyboard
    // and ensure they correspond to positions known to ZMK.
    ignored-key-positions = <LT0 LT1 LT2 LT3 RT0 RT1 RT2>; // Example subset, adjust as needed
    ignored-layers = <MOUSE>;
};

// Sticky-key and macro example
ZMK_STICKY_KEY(sls) {
    release-after-ms = <1000>;
    bindings = <&uc_shift>;
    ignore-modifiers;
};

ZMK_MACRO(uc_shift) {
    wait-ms = <0>;
    tap-ms = <1>;
    bindings = <&macro_press &mo UNICODE &kp LSHFT>,
               <&macro_pause_for_release>,
               <&macro_release &mo UNICODE &kp LSHFT>;
};

// Tap dance for copy-cut
ZMK_TAP_DANCE(copy_cut) {
    tapping-term-ms = <200>;
    bindings = <&kp LC(INS)>, <&kp LC(Z)>;
};

// Example layer keymap nodes (adjust as needed)
ZMK_LAYER(colemak,
    // Replace these &kp calls and &hmr, &hml references with actual keys defined for your layout
    &kp Q &kp W &kp E &kp R &kp T       &kp Y &kp U &kp I &kp O &kp P
    &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &hml RALT G   &hmr RALT H &hmr RCTRL J &hmr RSHFT K &hmr LALT L &hmr RGUI SEMICOLON
    &kp Z &kp X &kp C &kp V &kp B       &kp N &kp M &kp COMMA &kp DOT &kp SLASH
    // Adjust these thumb keys and layer taps as needed
    CTL_SPC &lt LOWER TAB &lt RAISE RET &smart_shft
);

// Add other layers similarly, ensuring no invalid references and proper arguments for behaviors

